# Generated demo bundle (product snapshot + fixtures + recording). Build output,
# never source. Rebuilt by publish/build-demo.
/bundle/

# Capture-walk staging (live product + record-shim). Build output, never source.
# Rebuilt by publish/capture/build-capture-staging.ps1. May hold a recording.json
# with demo data.
/capture-staging/

# Captured recordings staged outside the bundle (may be large and data-sensitive).
/publish/_captures/
*.har

# Node tooling (if the capture harness uses it)
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# alternate build output (locked-bundle workaround)
bundle2/

# alternate build output -- the merged all-database bundle. Same "build output,
# never source" status as /bundle/, but it was missing from this file: a git add -A
# would have staged 143 regenerable files including a ~27 MB recording.json.
# Recordings hold SANITIZED demo data, so this is a repo-weight and build-output
# rule, not a data-sensitivity one -- they are rebuildable from a capture walk and
# have no business in history.
bundle-all/

# Chunk recordings staged next to the capture harness (recording-demo*.json,
# recording-admin.json, etc). Same rationale: large, generated, rebuildable.
# Only affects untracked files, so nothing already committed here is disturbed.
/publish/capture/*.json

# Retired bundle awaiting delete (build-demo renames the old bundle aside before
# rebuilding, so a locked directory aborts the build instead of emptying it).
bundle._old/
bundle2._old/
bundle-all._old/

# Per-database demo bundles (build output, never source; one recording each,
# because DB-global GETs collide in a merged recording - see analyst-tour-scope.md).
bundle-demo2/
bundle-demo3/

# Staging output for a build-and-swap. The serve holds /bundle/ open, so a rebuild
# goes to bundle-next first, gets verified on its own port, and is renamed into
# place once the rail walk passes. Same "build output, never source" status as
# /bundle/ -- 157 files including three recordings.
bundle-next/

# Numbered retirees from repeated build-and-swap rounds (bundle._old2, ._old3 ...).
# The single-name entries above missed these and a git add -A would have staged
# 157 regenerable files per directory -- the same gap this file already records
# for bundle-all/.
bundle._old*/
